#import "@preview/silky-slides-insa:0.2.0": *
#import "@preview/mitex:0.2.7": *

// --- Theme Configuration ---
// insa-slides takes direct parameters: title, subtitle,
// title-visual, and insa (school identifier).
// Supported insa values: "rennes", "hdf", "cvl"
#show: insa-slides.with(
  // Direct parameters (NOT inside config-info)
  title: "Algorithmique Avancee",
  subtitle: "Marie Dupont -- 4INFO, Semestre 7",
  insa: "rennes",
  // title-visual: none,  // simple layout (default)
)

// The title slide is automatically generated by insa-slides.
// No need to call #title-slide() manually — it's already shown.

