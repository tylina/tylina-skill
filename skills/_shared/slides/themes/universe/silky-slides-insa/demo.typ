== Code source

#block[
  #set text(size: 14pt)

  ```python
  def tri_fusion(tableau: list[int]) -> list[int]:
      if len(tableau) <= 1:
          return tableau
      milieu = len(tableau) // 2
      gauche = tri_fusion(tableau[:milieu])
      droite = tri_fusion(tableau[milieu:])
      return fusionner(gauche, droite)

  def fusionner(g: list[int], d: list[int]) -> list[int]:
      resultat = []
      i = j = 0
      while i < len(g) and j < len(d):
          if g[i] <= d[j]:
              resultat.append(g[i]); i += 1
          else:
              resultat.append(d[j]); j += 1
      return resultat + g[i:] + d[j:]
  ```
]

